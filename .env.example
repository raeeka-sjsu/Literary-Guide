# Copy this file to `.env` (not committed) and fill in real keys
# `.env` is gitignored and must NEVER be checked in or shared in zips.

# Anthropic Claude — used as one of the comparison LLMs
# Get a key at https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI GPT-4o-mini — used as one of the comparison LLMs
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the Ollama host if not localhost:11434
# OLLAMA_HOST=http://localhost:11434
